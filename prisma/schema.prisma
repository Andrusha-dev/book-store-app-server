// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id           String   @id @default(uuid(7))
  email        String   @unique //Потрібен і для LOCAL і для OAuth, тому обовязкове
  passwordHash String? //Потрібен лише для LOCAL (для OAuth має значення null)
  username     String?  @unique
  firstname    String?
  lastname     String?
  phone        String?  @unique
  birthYear    Int?
  isMarried    Boolean  @default(false)
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  identities Identity[]
}

//Перелік провайдерів для автентифікації
enum IdentityProvider {
  GOOGLE
  GITHUB
}

//Модель автентифікації
model Identity {
  id         String           @id @default(uuid(7))
  provider   IdentityProvider
  providerId String //це унікальний ідентифікатор користувача в сервісі OAuth.
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Унікальний індекс, щоб один аккаунт соцмережі не прив'язали двічі
  @@unique([provider, providerId])
}
