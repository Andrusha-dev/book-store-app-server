// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs" //Потрібен для nest, щоб tsc міг правильно зкомпілювати клієнт Prisma
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id           String   @id @default(uuid(7))
  email        String   @unique // Потрібен і для LOCAL і для OAuth, тому обовязкове
  passwordHash String? // Потрібен лише для LOCAL (для OAuth має значення null)
  username     String?  @unique
  firstname    String?
  lastname     String?
  phone        String?  @unique
  birthYear    Int?
  isMarried    Boolean  @default(false)
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  identities Identity[]
  //При one to one @relation() вказувати не потрібно, бо вона вже вказана в моделі User.
  cart       Cart? //Поле карт опціональне, щоб не викликати конфлікту при одночасному створенні запису в User та Cart
  orders     Order[]
}

// Перелік провайдерів для автентифікації
enum IdentityProvider {
  GOOGLE
  GITHUB
}

// Модель автентифікації
model Identity {
  id         String           @id @default(uuid(7))
  provider   IdentityProvider
  providerId String // це унікальний ідентифікатор користувача в сервісі OAuth.
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Унікальний індекс, щоб один аккаунт соцмережі не прив'язали двічі
  @@unique([provider, providerId])
}

enum CoverType {
  HARD
  SOFT
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Product {
  id          String        @id @default(uuid(7))
  name        String
  imgUrls     String[]
  price       Decimal       @db.Decimal(10, 2)
  description String?       @db.Text
  quantity    Int           @default(0)
  status      ProductStatus @default(DRAFT)
  widthMm     Int
  heightMm    Int
  depthMm     Int
  weightGrams Int
  isbn        String        @unique
  pages       Int
  coverType   CoverType
  language    String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  categories  Category[] //many to many
  authorId    String
  author      Author      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  publisherId String
  publisher   Publisher   @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  cartItems   CartItem[]
  orderItems  OrderItem[]
}

model Category {
  id        String   @id @default(uuid(7))
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[] //many to many
}

model Author {
  id          String   @id @default(uuid(7))
  name        String   @unique
  imgUrl      String
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
}

model Publisher {
  id        String   @id @default(uuid(7))
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model Cart {
  id        String   @id @default(uuid(7))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String     @unique
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items  CartItem[]
}

model CartItem {
  id        String   @id @default(uuid(7))
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
}

enum OrderStatus {
  PENDING
  PROCESSING
  DELIVERING
  COMPLETED
  CANCELLED //Скасування замовлення
}

enum OrderPaymentMethod {
  CARD
  CASH
}

model Order {
  id            String             @id @default(uuid(7))
  amount        Decimal            @db.Decimal(10, 2)
  status        OrderStatus        @default(PENDING)
  paymentMethod OrderPaymentMethod
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  items    OrderItem[]
  userId   String
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments Payment[]
  delivery Delivery?
}

model OrderItem {
  id        String   @id @default(uuid(7))
  quantity  Int
  price     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Payment {
  id         String        @id @default(uuid(7))
  status     PaymentStatus @default(PENDING)
  externalId String        @unique //ID інвойсу в платіжній системі
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

/**
 * //Знадобиться, коли окрім нової пошти зявиться ще укрпошта
 * enum DeliveryProvider {
 * NOVA_POSHTA
 * UKRPOSHTA
 * }
 */

enum DeliveryMethod {
  WAREHOUSE // Відділення
  POSTOMAT // Поштомат
}

model Delivery {
  id                String         @id @default(uuid(7))
  method            DeliveryMethod
  recipientFullname String
  recipientPhone    String
  cityName          String
  cityRef           String //UUID міста в API Нової Пошти / Укрпошти (для автоматичного створення ТТН)
  warehouseName     String //Наприклад: "Відділення №15 (до 30 кг)"
  warehouseRef      String //UUID відділення/поштомату в API служби доставки
  trackingNumber    String? //Номер ТТН
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  orderId String @unique // Зв'язок 1-до-1 з Order
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
}
